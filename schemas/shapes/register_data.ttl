@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix qudt:   <http://qudt.org/schema/qudt/> .
@prefix pcl:    <https://w3id.org/pcl-profile/action/v1/terms#> .

###############################################################################
# Root shape for a data registration content entity
###############################################################################

pcl:DataRegistrationShape
    a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Dataset must have a name" ;
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:minCount 1 ;
        sh:message "Dataset must have an identifier (for example a DOI or IGSN)" ;
    ] ;
    sh:property [
        sh:path schema:distribution ;
        sh:minCount 1 ;
        sh:node pcl:DataDistributionShape ;
        sh:message "Dataset must declare at least one retrievable distribution" ;
    ] .

###############################################################################
# Distribution shape: the retrievable, checksummed artifact being registered
###############################################################################

pcl:DataDistributionShape
    a sh:NodeShape ;
    sh:targetClass schema:DataDownload ;
    sh:property [
        sh:path schema:contentUrl ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Distribution must be retrievable from a contentUrl" ;
    ] ;
    sh:property [
        sh:path schema:encodingFormat ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Distribution must declare a media type, for example application/json" ;
    ] ;
    sh:property [
        sh:path schema:sha256 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Fa-f0-9]{64}$" ;
        sh:message "Distribution must include a SHA-256 checksum" ;
    ] .
